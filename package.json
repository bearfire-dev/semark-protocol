{
  "name": "@paperkeel/oxlint-plugin-semark",
  "version": "0.1.1",
  "description": "Enforce Semark Protocol signatures and comment rules with Oxlint.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "./scripts/check.sh",
    "lint": "oxlint --deny-warnings src tests",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@microsoft/tsdoc": "0.16.0",
    "@oxlint/plugins": "1.80.0"
  },
  "peerDependencies": {
    "oxlint": ">=1.80.0 <2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "oxlint": "1.80.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paperkeel/semark-protocol.git"
  },
  "bugs": {
    "url": "https://github.com/paperkeel/semark-protocol/issues"
  },
  "homepage": "https://github.com/paperkeel/semark-protocol#readme",
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "semark",
    "typescript",
    "tsdoc"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
